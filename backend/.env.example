# Database (adjust host/port if using docker-compose: docker maps 5433 -> 5432)
DATABASE_URL=postgresql+asyncpg://hireflow_user:hireflow_password@localhost:5432/hireflow_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
SECRET_KEY=replace_with_a_random_32+_char_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI / External APIs
GEMINI_API_KEY=     # Google GenAI (Gemini) API key
DEEPGRAM_API_KEY=   # Deepgram API key (STT/TTS)

# File upload / limits
UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=10

# App / CORS
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
